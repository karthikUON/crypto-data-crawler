# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crypto_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Crawler Configuration
CRYPTO_API_URL=https://api.coingecko.com/api/v3
CRAWLER_INTERVAL=300
TOP_N_CRYPTOS=50

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
RETRY_MAX_DELAY=60

# Logging
LOG_LEVEL=INFO